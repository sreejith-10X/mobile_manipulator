<?xml version="1.0"?>
<robot name="my_robot"
        xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- Base Link Dimensions (TurtleBot3 Burger scale) -->
    <xacro:property name="base_length" value="0.30"/>
    <xacro:property name="base_width" value="0.14"/>
    <xacro:property name="base_height" value="0.08"/>
    <xacro:property name="base_mass" value="1.0"/>

    <!-- Drive Wheel Dimensions (D = 66mm, W = 18mm) -->
    <xacro:property name="wheel_radius" value="0.033"/>
    <xacro:property name="wheel_length" value="0.018"/>
    <xacro:property name="wheel_mass" value="0.05"/>

    <!-- Caster Wheel Dimensions (Ball caster) -->
    <xacro:property name="caster_radius" value="0.01"/>
    <xacro:property name="caster_mass" value="0.01"/>

    <!-- Camera Dimensions (Tiny camera module) -->
    <xacro:property name="camera_length" value="0.015"/>
    <xacro:property name="camera_width" value="0.020"/>
    <xacro:property name="camera_height" value="0.012"/>
    <xacro:property name="camera_mass" value="0.03"/>

    <!--lidar dimensions _____> -->
    <xacro:property name="lidar_radius" value="0.025"/>
    <xacro:property name="lidar_height" value="0.02"/>
    <xacro:property name="lidar_mass" value="0.05"/>

<!-- /____________________________________________________________________ -->


    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0.0 0.0 ${base_height / 2.0}" rpy="0.0 0.0 0.0"/>
            <material name="gre">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0.0 0.0 ${base_height / 2.0}" rpy="0.0 0.0 0.0"/>
          
        </collision>
        <xacro:inertial_box m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 ${base_height / 2.0}" o_rpy="0 0 0 "/>
    </link>


    <link name="base_footprint"/>

    
    <xacro:macro name="wheel" params="prefix">
        <link name="${prefix}_wheel_link">  
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>  
                </geometry>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <xacro:red/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>  
                </geometry>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            </collision>
            <xacro:inertial_cylinder m="${wheel_mass}" r="${wheel_radius}" l="${wheel_length}" o_xyz="0 0 0" o_rpy="1.5708 0 0 "/>
        </link>
    </xacro:macro>


    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>      
            </geometry>
            <xacro:red/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}"/>      
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
         
        </collision>
        <xacro:caster_inertial m="${caster_mass}" r="${caster_radius}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <xacro:wheel prefix="right"/>
    <xacro:wheel prefix="left"/>

    <link name="camera">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
            <xacro:red/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            
        </collision>
        <xacro:inertial_box m="${camera_mass}" x="${camera_length}" y="${camera_width}" z="${camera_height}" o_xyz="0 0 0" o_rpy="0 0 0"/>
            
        
    </link>

    <link name="lidar_link" >
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}"  length="${lidar_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <xacro:red/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}"  length="${lidar_height}"/>

            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>

        </collision>
        <xacro:inertial_cylinder m="${lidar_mass}" r="${lidar_radius}" l="${lidar_height}" o_xyz="0 0 0" o_rpy="0 0 0 "/>

    </link>





<!-- ___________________________________________________________________________ -->


    <joint name="footprint_base" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.033" rpy="0 0 0"/>
        
    </joint>

    <xacro:macro name="wheel_joint" params="prefix x y z ">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel_link"/>
            <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            
        </joint>
        
    </xacro:macro>

    <joint name="caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <axis xyz="0 0 1"/>
        <origin xyz="0.11 0 -0.023" rpy="0 0 0"/>
        
    </joint>    

    <xacro:wheel_joint prefix="right" x="-0.075" y="-0.079" z="0"/>

    <xacro:wheel_joint prefix="left" x="-0.075" y="0.079" z="0"/>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera"/>
        <origin xyz="0.15 0 0.04" rpy="0 0 0"/>

    </joint>

    <joint name="lidar_base" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.05 0 0.09" rpy="0 0 0 "/>
    </joint>

</robot>